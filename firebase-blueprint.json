{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account metadata stored upon signup",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string" },
        "displayName": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Resume": {
      "title": "User Resume File",
      "description": "Uploaded resume metadata and parsed text content",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "size": { "type": "integer" },
        "type": { "type": "string" },
        "uploadedAt": { "type": "string" },
        "content": { "type": "string" }
      },
      "required": ["id", "userId", "name", "size", "uploadedAt"]
    },
    "Analysis": {
      "title": "AI Resume Analysis",
      "description": "Resume tailoring suggestions, matching scores, and action items generated by Gemini",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "resumeId": { "type": "string" },
        "resumeName": { "type": "string" },
        "targetCompany": { "type": "string" },
        "targetRole": { "type": "string" },
        "jobDescription": { "type": "string" },
        "createdAt": { "type": "string" },
        "matchingScore": { "type": "integer" },
        "tailoredContent": { "type": "string" },
        "suggestedChanges": { "type": "string" }
      },
      "required": [
        "id",
        "userId",
        "resumeId",
        "resumeName",
        "targetCompany",
        "targetRole",
        "createdAt"
      ]
    },
    "CompanyIntelligence": {
      "title": "Company Intelligence Profile",
      "description": "Public company resolution, verified careers presence, and observed hiring patterns",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "normalizedName": { "type": "string" },
        "displayName": { "type": "string" },
        "officialWebsite": { "type": "string" },
        "confidence": { "type": "string" },
        "status": { "type": "string" },
        "lastUpdatedAt": { "type": "string" }
      },
      "required": ["id", "companyId", "normalizedName", "confidence", "status"]
    },
    "RoleIntelligence": {
      "title": "Role Intelligence Profile",
      "description": "Public role normalization, observed market skills, technologies, and career requirements",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roleId": { "type": "string" },
        "originalRole": { "type": "string" },
        "normalizedRole": { "type": "string" },
        "roleFamily": { "type": "string" },
        "specialization": { "type": "string" },
        "seniority": { "type": "string" },
        "confidence": { "type": "string" },
        "status": { "type": "string" },
        "lastUpdatedAt": { "type": "string" }
      },
      "required": ["id", "roleId", "normalizedRole", "roleFamily", "seniority", "confidence", "status"]
    },
    "LearningEvent": {
      "title": "Learning Event Record",
      "description": "User interaction, tailoring decision, or recommendation feedback event with sanitized metadata",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "userId": { "type": "string" },
        "eventType": { "type": "string" },
        "timestamp": { "type": "string" },
        "modelVersion": { "type": "string" }
      },
      "required": ["eventId", "userId", "eventType", "timestamp", "modelVersion"]
    },
    "LearningAggregate": {
      "title": "Aggregated Learning Signal",
      "description": "Non-PII empirical counts and weights for role, technology, and recommendation patterns",
      "type": "object",
      "properties": {
        "aggregateId": { "type": "string" },
        "scopeKey": { "type": "string" },
        "totalObservations": { "type": "integer" },
        "weightedScore": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["aggregateId", "scopeKey", "totalObservations", "weightedScore", "updatedAt"]
    },
    "ModelMetadata": {
      "title": "Learning Model Metadata",
      "description": "Version tracking, global evaluation metrics, and learning status",
      "type": "object",
      "properties": {
        "modelVersion": { "type": "string" },
        "status": { "type": "string" },
        "totalEventsProcessed": { "type": "integer" },
        "updatedAt": { "type": "string" }
      },
      "required": ["modelVersion", "status", "totalEventsProcessed", "updatedAt"]
    },
    "JobSnapshot": {
      "title": "Job Market Snapshot",
      "description": "Immutable point-in-time snapshot of an ingested job posting with cryptographic provenance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "jobId": { "type": "string" },
        "companyName": { "type": "string" },
        "roleTitle": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "sourceDomain": { "type": "string" },
        "sourceType": { "type": "string" },
        "sourceHash": { "type": "string" },
        "status": { "type": "string" },
        "snapshotTimestamp": { "type": "string" }
      },
      "required": ["id", "jobId", "companyName", "roleTitle", "sourceType", "sourceHash", "status", "snapshotTimestamp"]
    },
    "MarketAggregate": {
      "title": "Market Aggregate Requirements",
      "description": "Recency-decayed aggregate skill and technology frequencies for a role or company",
      "type": "object",
      "properties": {
        "aggregateId": { "type": "string" },
        "roleKey": { "type": "string" },
        "companyKey": { "type": "string" },
        "window": { "type": "string" },
        "sampleSize": { "type": "integer" },
        "lastAggregatedAt": { "type": "string" }
      },
      "required": ["aggregateId", "window", "sampleSize", "lastAggregatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile collection, identified by authentication UID"
    },
    "/users/{userId}/resumes/{resumeId}": {
      "schema": "Resume",
      "description": "User resumes subcollection, containing parsed contents and metadata"
    },
    "/users/{userId}/analyses/{analysisId}": {
      "schema": "Analysis",
      "description": "User resume tailoring analyses subcollection"
    },
    "/users/{userId}/learningEvents/{eventId}": {
      "schema": "LearningEvent",
      "description": "Isolated user learning events subcollection"
    },
    "/companyIntelligence/{companyId}": {
      "schema": "CompanyIntelligence",
      "description": "Universal public company intelligence documents keyed by canonical company ID"
    },
    "/roleIntelligence/{roleId}": {
      "schema": "RoleIntelligence",
      "description": "Universal public role intelligence documents keyed by canonical role ID"
    },
    "/learningAggregates/{aggregateId}": {
      "schema": "LearningAggregate",
      "description": "Non-PII system-wide aggregate signals"
    },
    "/modelMetadata/{modelId}": {
      "schema": "ModelMetadata",
      "description": "Model versioning and evaluation metrics"
    },
    "/jobSnapshots/{snapshotId}": {
      "schema": "JobSnapshot",
      "description": "Public immutable job posting snapshots with verifiable provenance"
    },
    "/marketAggregates/{aggregateId}": {
      "schema": "MarketAggregate",
      "description": "Recency-weighted market trend aggregates across roles and companies"
    }
  }
}
